{
  "name": "listenriver.com",
  "version": "1.0.0",
  "description": "Source repository for `listenriver.com`.",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "check:urls": "python scripts/url-guard.py check --site public",
    "build": "hugo --minify && npm run clean:pagefind && pagefind --site public && npm run check:pagefind-output",
    "clean:pagefind": "node scripts/clean-pagefind.mjs",
    "check:pagefind-output": "node scripts/check-pagefind-output.mjs",
    "check:search": "npm run build && npm run check:search-ux",
    "check:search-ux": "node scripts/check-search-ux.mjs",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wenyang5566/listenriver.com.git"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "module",
  "bugs": {
    "url": "https://github.com/wenyang5566/listenriver.com/issues"
  },
  "homepage": "https://github.com/wenyang5566/listenriver.com#readme",
  "devDependencies": {
    "@playwright/test": "^1.60.0",
    "@types/node": "^25.7.0",
    "pagefind": "^1.5.2"
  }
}
